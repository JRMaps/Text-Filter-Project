{
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/(tabs)/messages.jsx",
    "app/(tabs)/chat.tsx",
    "app/_layout.jsx",
    "app/(tabs)/_layout.jsx",
    "app/(auth)/register.jsx",
    "app/(auth)/login.jsx"
, "constants/theme.ts"  ],
  "extends": "expo/tsconfig.base"
}
